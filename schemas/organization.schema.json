{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://independent-ai-safety.net/schemas/organization.schema.json",
  "title": "Organization",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "aliases", "website", "canonical_domains", "description", "status", "scope", "primary_display_type", "geography", "entity_type", "leadership", "risk_domains", "lifecycle_stages", "activities", "models_evaluated", "access_models", "independence", "source_refs", "first_seen", "last_verified", "next_review_due", "confidence", "contradictions"],
  "properties": {
    "id": { "type": "string", "pattern": "^org-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 2 },
    "legal_name": { "type": ["string", "null"] },
    "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "website": { "type": "string", "format": "uri", "pattern": "^https://" },
    "canonical_domains": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" } },
    "description": { "type": "string", "minLength": 20, "maxLength": 300 },
    "founded_date": { "type": ["string", "null"], "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$" },
    "status": { "enum": ["active", "inactive", "merged", "unknown"] },
    "scope": { "enum": ["core", "context"] },
    "primary_display_type": { "enum": ["organization", "funder", "frontier-developer", "government-regulator", "fiscal-sponsor-incubator", "standards-body", "program"] },
    "geography": { "type": "object", "additionalProperties": false, "required": ["country", "city", "geographic_scope"], "properties": { "country": { "type": ["string", "null"] }, "city": { "type": ["string", "null"] }, "geographic_scope": { "type": "array", "items": { "type": "string" } } } },
    "entity_type": { "enum": ["nonprofit", "fiscally-sponsored-project", "academic-center", "government-body", "commercial-company", "standards-professional-body", "intergovernmental-body", "foundation", "unknown"] },
    "legal_form": { "type": ["string", "null"] },
    "tax_identifiers": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["jurisdiction", "identifier"], "properties": { "jurisdiction": { "type": "string" }, "identifier": { "type": "string" } } } },
    "parent_or_sponsor_id": { "type": ["string", "null"], "pattern": "^org-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "leadership": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "role"], "properties": { "name": { "type": "string" }, "role": { "type": "string" } } } },
    "mission": { "type": ["string", "null"] },
    "claimed_theory_of_change": { "type": ["string", "null"] },
    "risk_domains": { "$ref": "#/$defs/classification" },
    "lifecycle_stages": { "$ref": "#/$defs/classification" },
    "activities": { "$ref": "#/$defs/classification" },
    "models_evaluated": { "type": "array", "items": { "type": "string" } },
    "access_models": { "type": "array", "uniqueItems": true, "items": { "enum": ["public-api", "pre-release", "embedded", "weights", "internal-records", "other", "unknown"] } },
    "independence": { "$ref": "#/$defs/independence" },
    "source_refs": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^src-" } } },
    "first_seen": { "type": "string", "format": "date" },
    "last_verified": { "type": "string", "format": "date" },
    "next_review_due": { "type": "string", "format": "date" },
    "confidence": { "enum": ["high", "medium", "low", "unknown"] },
    "reviewer_notes": { "type": ["string", "null"] },
    "contradictions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["field", "summary", "source_ids"], "properties": { "field": { "type": "string" }, "summary": { "type": "string" }, "source_ids": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^src-" } } } } }
  },
  "$defs": {
    "classification": { "type": "object", "additionalProperties": false, "required": ["primary", "secondary"], "properties": { "primary": { "type": ["string", "null"] }, "secondary": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } } },
    "independence": { "type": "object", "additionalProperties": false, "required": ["legal_independence", "developer_cash_funding_policy", "developer_cash_funding_share", "developer_in_kind_support", "appointment_control", "operational_control", "publication_rights", "conflict_policy_public", "funding_disclosure_quality", "notes", "limitations"], "properties": {
      "legal_independence": { "enum": ["separate-legal-entity", "fiscally-sponsored-project", "academic-unit", "government-body", "commercial-company", "unknown"] },
      "developer_cash_funding_policy": { "enum": ["accepts", "does-not-accept", "restricted", "undisclosed", "unknown"] },
      "developer_cash_funding_share": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
      "developer_in_kind_support": { "type": "array", "uniqueItems": true, "items": { "enum": ["model-access", "api-credits", "compute", "staff-time", "office-space", "other", "none-disclosed", "unknown"] } },
      "appointment_control": { "type": ["string", "null"] },
      "operational_control": { "type": ["string", "null"] },
      "publication_rights": { "enum": ["independent", "narrow-redaction", "client-approval-required", "unpublished-private", "unknown"] },
      "conflict_policy_public": { "enum": ["yes", "no", "unknown"] },
      "funding_disclosure_quality": { "enum": ["complete", "partial", "minimal", "unknown"] },
      "notes": { "type": ["string", "null"] },
      "limitations": { "type": ["string", "null"] }
    } }
  }
}
