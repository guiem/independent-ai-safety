{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://independent-ai-safety.net/schemas/observation.schema.json",
  "title": "Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subject_id", "metric", "value", "unit", "as_of", "period_start", "period_end", "method", "source_ids", "confidence", "notes"],
  "properties": {
    "id": { "type": "string", "pattern": "^obs-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "subject_id": { "type": "string", "pattern": "^org-" },
    "metric": { "enum": ["annual-revenue", "operating-budget", "headcount", "research-output-count", "evaluation-benchmark-count"] },
    "value": { "type": ["number", "null"], "minimum": 0 },
    "unit": { "type": "string", "minLength": 1 },
    "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
    "as_of": { "type": ["string", "null"], "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$" },
    "period_start": { "type": ["string", "null"], "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$" },
    "period_end": { "type": ["string", "null"], "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$" },
    "method": { "type": "string", "minLength": 3 },
    "source_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^src-" } },
    "confidence": { "enum": ["high", "medium", "low", "unknown"] },
    "notes": { "type": ["string", "null"] }
  }
}

