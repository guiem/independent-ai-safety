{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://independent-ai-safety.net/schemas/source.schema.json",
  "title": "Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "url", "title", "publisher", "retrieval_date", "source_type", "support", "reliability_tier"],
  "properties": {
    "id": { "type": "string", "pattern": "^src-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "title": { "type": "string", "minLength": 3 },
    "publisher": { "type": "string", "minLength": 2 },
    "publication_date": { "type": ["string", "null"], "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$" },
    "retrieval_date": { "type": "string", "format": "date" },
    "source_type": { "enum": ["official-page", "annual-report", "audited-accounts", "legal-filing", "registry", "funder-database", "government-record", "research-paper", "program-report", "journalism", "directory", "social-post"] },
    "archival_url": { "type": ["string", "null"], "format": "uri" },
    "support": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["claim", "evidence"], "properties": { "claim": { "type": "string", "minLength": 3 }, "evidence": { "type": "string", "minLength": 3 }, "location": { "type": ["string", "null"] } } } },
    "reliability_tier": { "enum": ["primary", "secondary", "discovery-only"] },
    "notes": { "type": ["string", "null"] }
  }
}
